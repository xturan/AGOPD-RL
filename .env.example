# Copy to .env and adjust. No secrets belong here.
AGOPD_ROOT=${AGOPD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}
AGOPD_VLLM_VENV=${AGOPD_VLLM_VENV:-${AGOPD_ROOT}/.venv-vllm}
AGOPD_OPD_VENV=${AGOPD_OPD_VENV:-${AGOPD_ROOT}/.venv-opd}
# Optional: outbound proxy for model/package downloads
AGOPD_PROXY_URL=${AGOPD_PROXY_URL:-}

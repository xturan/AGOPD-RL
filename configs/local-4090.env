# Local two-RTX-4090 runtime. Keep this file free of machine-specific secrets.
AGOPD_PROJECT_DIR=${AGOPD_PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
AGOPD_ENV_DIR=${AGOPD_ENV_DIR:-${HOME}/.conda/envs/agopd-vllm-281}
AGOPD_RUNTIME_DIR=${AGOPD_RUNTIME_DIR:-${AGOPD_PROJECT_DIR}/.runtime}
AGOPD_VERL_DIR=${AGOPD_VERL_DIR:-${AGOPD_RUNTIME_DIR}/verl-v0.6.1}
AGOPD_PROXY_URL=${AGOPD_PROXY_URL:-http://127.0.0.1:<YOUR_PROXY_PORT>}
AGOPD_PIP_INDEX_URL=${AGOPD_PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}
AGOPD_NGPUS=${AGOPD_NGPUS:-2}
AGOPD_TRAIN_BATCH_SIZE=${AGOPD_TRAIN_BATCH_SIZE:-8}
AGOPD_TRAIN_STEPS=${AGOPD_TRAIN_STEPS:-10}
AGOPD_MODEL_PATH=${AGOPD_MODEL_PATH:-${AGOPD_PROJECT_DIR}/models/Qwen3-1.7B}
AGOPD_TEACHER_MODEL_PATH=${AGOPD_TEACHER_MODEL_PATH:-${AGOPD_PROJECT_DIR}/models/Qwen3-4B}
AGOPD_TRAIN_FILE=${AGOPD_TRAIN_FILE:-${AGOPD_PROJECT_DIR}/data/dapo-verl-v1/train.parquet}
AGOPD_VAL_FILE=${AGOPD_VAL_FILE:-${AGOPD_PROJECT_DIR}/data/dapo-verl-v1/val.parquet}
